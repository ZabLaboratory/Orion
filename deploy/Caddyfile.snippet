# Caddyfile snippet for Orion — drop into the VPS Caddyfile.
#
# Orion has TWO public surfaces:
#   1. The control plane API (orion-api:4007) — called by ZabGate, not public.
#      Already reachable through zabgate.cyell.dev/orion/* via the gateway
#      routing in ZabGate/src/zabgate/config.py — no dedicated Caddy entry
#      needed for the control plane.
#
#   2. The MediaMTX media endpoints — MUST be public because the browser POSTs
#      WHIP SDP offers directly, and Twitch reads the HLS preview (optional).
#      We expose these on a dedicated subdomain so we can stream-proxy them.

# ---- MediaMTX media endpoints ----
# WHIP + HLS playback. `stream: true` is critical — WebRTC will not survive the
# default HTTP/2 buffered proxy path.
orion-media.cyell.dev {
	encode zstd gzip

	# WHIP ingress (WebRTC-HTTP Ingestion Protocol — RFC 9725)
	#   POST /<path>/whip      → SDP offer
	#   DELETE <Location>       → teardown
	handle_path /* {
		reverse_proxy orion-mediamtx:8889 {
			# Keep-alive for long-lived WebRTC sessions.
			transport http {
				keepalive 300s
				keepalive_idle_conns 10
			}
		}
	}

	log {
		output file /var/log/caddy/orion-media.log
		format json
	}
}

# ---- Optional HLS preview ----
# Only useful if you want a low-quality server-rendered preview alongside the
# WebRTC stream. Comment out if not needed.
#
# orion-hls.cyell.dev {
# 	reverse_proxy orion-mediamtx:8888
# }

# ---- RTMP ingress (optional) ----
# If you want to accept classic RTMP publishers (e.g. a legacy OBS instance)
# they need TCP:1935 directly — Caddy doesn't front raw TCP without the
# layer4 plugin. On the VPS, expose :1935 in the firewall and point it at the
# orion-mediamtx container with a simple nftables/ufw rule instead of Caddy.

# ---------------------------------------------------------------------------
# Expected DNS records (set these alongside the existing *.cyell.dev entries):
#   orion-media.cyell.dev  A     <VPS IPv4>
#   orion-media.cyell.dev  AAAA  <VPS IPv6>   (optional)
#
# After editing the Caddyfile on the VPS:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
