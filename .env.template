# Orion v2 — local Prism sidecar environment template
# Copy to Prism's local runtime directory (never commit secrets). Orion runs
# only as this local sidecar; every listener and browser-facing endpoint is
# loopback-only.

# --- HTTP / WS ---
ORION_LISTEN_ADDR=127.0.0.1:4007
ORION_INTERNAL_ADDR=127.0.0.1:4017    # /internal/metrics, local diagnostics only
# B7 (ADR 003 §3.1.6, #89): /internal/metrics exports
# `orion_task_cpu_seconds_total{scene_id,scene_version}` — per-scene-version
# exec CPU. Incident SIGNAL only (no auto-kill, doctrine §1.1); the alert
# threshold, runbook and compose CPU limits are the Keeper-side volet.
ORION_PUBLIC_BASE_URL=http://127.0.0.1:4007

# --- Local persistence ---
# The embedded runtime uses SQLite below. ORION_DATABASE_URL is intentionally
# empty: the legacy network database setting is disabled.
ORION_DATABASE_URL=

# --- Asset filesystem root (content-addressed) ---
ORION_ASSET_ROOT=/var/lib/orion/assets

# --- Static Solar bundle root (per-version directories) ---
ORION_SOLAR_ROOT=/var/lib/orion/solar

# --- Compiler fetch cache (content-addressed layout + pinned blueprint graph) ---
# Immutable upstream fetches are cached here so a re-push does not re-fetch
# them over the WAN. Empty disables the cache.
ORION_COMPILER_CACHE_DIR=/var/lib/orion/compiler-cache

# --- Auth ---
# ZabAuth /validate endpoint, called via ZabGate.
# Cache TTL bounds how long Orion trusts a "valid" answer for a given jti.
ORION_ZABAUTH_VALIDATE_URL=http://127.0.0.1:4000/auth/api/v1/tokens
ORION_AUTH_CACHE_TTL_S=60

# Durable service token (ADR ZabAuth 003 Amendment 3 § A3.3 parts 1/2/5).
# Orion holds its outbound credential BY POSSESSION of a refresh token and
# never mints: the first act of the boot is a rotation.
#
#   - ORION_SERVICE_REFRESH_TOKEN is an amorce, not the source of truth. It
#     is resolved only when the database holds nothing, consumed by the first
#     rotation, and then PURGED from étage 1 and from the GitHub secret.
#     Re-injecting it after the family is established replays a spent
#     generation: ZabAuth answers `reuse` and revokes the whole family (§ 5 R8).
#   - ORION_ENCRYPTION_KEY is base64 of 32 FRESHLY generated random bytes
#     (`openssl rand -base64 32`). It encrypts the durable refresh token at
#     rest (AES-256-GCM). It must be distinct from QUASAR_ENCRYPTION_KEY,
#     COSMOS_ENCRYPTION_KEY and BLUE_ENCRYPTION_KEY — a service-owned key
#     never crosses a service boundary. Malformed or absent ⇒ the durable
#     manager refuses to arm (never a plaintext write, never a failed boot).
#
# These values are optional for the local sidecar. Never seed them from a
# remote production environment: local Orion must not rotate a remote token
# family or create a second Orion authority.
ORION_SERVICE_REFRESH_TOKEN=
ORION_ENCRYPTION_KEY=

# Static long-lived service token — local DEV/TEST ONLY. Leave empty unless a
# local gateway fixture explicitly requires it.
ORION_SERVICE_TOKEN=

# Paths claim attached to the minted service token. Comma-separated.
# Default narrows to the only outbound surface Orion exercises today
# (the stream-key proxy into Quasar). Add prefixes here when Orion
# gains other authenticated outbound calls.
#
# db.query topology A (R9 lift, ADR 006 §3.4): the `_query` delegation
# rides THIS same minted token. Every declared ORION_DATASOURCES service
# needs its `query.read.<svc>` scope listed here, e.g. for
# ORION_DATASOURCES=truth=truth,ranking=ranking add
# `query.read.truth,query.read.ranking`. The token is read LIVE per
# request, so a rotation is reflected without a restart.
ORION_SERVICE_PATHS=quasar.credentials.read,query.read.truth,query.read.ranking

# The durable family behind ORION_SERVICE_REFRESH_TOKEN MUST be minted with
# the same values in `exchange_paths`. `paths` grants the resulting token;
# `exchange_paths` grants the family permission to mint that token. Omitting
# the latter allows rotation to succeed but leaves Orion unable to fetch Blue
# curated routes, so scene compilation cannot start.

# --- Upstream services (compile-time fetch) ---
ORION_CANVAS_BASE_URL=http://127.0.0.1:4000/canvas
ORION_BLUE_BASE_URL=http://127.0.0.1:4000/blue
ORION_QUASAR_BASE_URL=http://127.0.0.1:4000/quasar

# --- Runtime behaviour ---
ORION_TICK_HZ=60
ORION_PUSH_TIMEOUT_S=10
ORION_LOG_LEVEL=info
ORION_LOG_FORMAT=json   # json | text

# --- Phase-3 async effects (ADR 003 §3.1.3, issue #85) ---
# Parsed at boot and WIRED on air (R9 lift, ADR 006 §3.4 / M2): a scene
# registers the world-effect ops ONLY when it loads a validated,
# exec-bearing program set. A non-validated or pure-dataflow scene never
# registers them — zero egress, zero query backstage. The bundle below
# confers no capability on its own; the validation gate is the seam.

# `http.request` egress policy (R2/B1 — fail-closed). CSV of hostnames
# the blueprint-authored http.request may reach. EMPTY = DENY-ALL.
# https-only unless ORION_HTTP_EGRESS_ALLOW_HTTP=true. Private /
# loopback / link-local / metadata destinations are always denied on
# the IP resolved after DNS (anti-SSRF, no rebinding).
ORION_HTTP_EGRESS_ALLOW_HOSTS=
ORION_HTTP_EGRESS_ALLOW_HTTP=false

# `db.query` DataSource allowlist (topology A — Amendment 1). CSV of
# <logical_name>=<zabgate_svc>; Orion calls
# POST ${ORION_ZABGATE_URL}/<svc>/api/v1/_query with its service token
# (scope query.read.<svc> — add it to ORION_SERVICE_PATHS when minting).
# Orion holds no DB credential and emits no SQL. An undeclared
# DataSource fails compile with DATASOURCE_NOT_DECLARED.
ORION_DATASOURCES=
ORION_ZABGATE_URL=http://127.0.0.1:4000

# --- optional local scene-intent ---
# Leave the workload/mTLS fields empty in the standalone sidecar. If a local
# gateway fixture enables scene-intent, it supplies loopback endpoints and
# local certificate paths through Prism at spawn time.
ORION_WORKLOAD_ZABGATE_URL=
ORION_WORKLOAD_CLIENT_CERT_PATH=
ORION_WORKLOAD_CLIENT_KEY_PATH=
ORION_WORKLOAD_CA_PATH=
ORION_WORKLOAD_SAN=
ORION_CANVAS_TRUST_PATH=
ORION_CANVAS_LOCATOR_PREFIX=/api/v1/scenes/
# These two values must match an actual Canvas resolved-scene-ref claim.
ORION_OWNER_ID=
ORION_TENANT_ID=

# Async-effect worker pool bounds.
ORION_EFFECT_WORKERS=8
ORION_EFFECT_QUEUE=256

# Per-stream egress budget for `core.service.call@1` (ADR Blue 009
# Amendment 2 §B, item 9 — the R3 condition of the G0 Bastion clearance).
# At most ORION_EGRESS_BUDGET_PER_STREAM curated egress calls per
# ORION_EGRESS_BUDGET_WINDOW_S seconds, PER STREAM (the live show, or an
# isolated preview / test session — each meters independently, so one
# saturated stream never starves another). Over budget the node fails
# closed to its `error` port (EGRESS_BUDGET_EXCEEDED) — never a request,
# never a crash. This bounds a compromised scene / chat feedback loop from
# hammering a downstream service (ZabCam) through the curated route.
# Default 60 / 10 s (6/s sustained, burst 60). Setting the budget to 0
# DISABLES the bound (opt-out — logged at boot; R3 requires a positive
# bound before a WRITE route opens on the antenna path).
ORION_EGRESS_BUDGET_PER_STREAM=60
ORION_EGRESS_BUDGET_WINDOW_S=10

# Meet viewer-credentials rotation interval (ADR Blue 009 §3.2, issue #261 —
# R1, Bastion-gated). In the local runtime, Orion resolves the armed `peer_label`s
# (the stream-level slot bindings) to their live room RECEIVE-ONLY viewer
# credentials via ZabCam and carries them on the reserved `__cam.viewer` LSDP
# leaf so Solar can join the Meet room(s) as a viewer. Viewer tokens are
# short-lived: every ORION_VIEWER_CREDS_REFRESH_S seconds Orion re-fetches and
# re-emits, replacing a rotated/expired token on the wire. The meet_token never
# reaches a blueprint/_query surface and is never logged. Default 240. 0
# DISABLES the refresh ticker (arming still re-runs on a slot-assignment change).
ORION_VIEWER_CREDS_REFRESH_S=240

# Scene-validation gate (ADR 003 §3.2, issue #87). The budget bounds one
# entrypoint's PROOF, never the engine: a divergent logic crosses it, fails
# validation, and never reaches air — the language loses nothing.
#   ORION_VALIDATION_MAX_STEPS  — per-entrypoint step budget (0 = unbounded).
#   ORION_VALIDATION_MAX_WALL_S — per-entrypoint wall budget (0 = unbounded).
#   ORION_VALIDATION_TIMEOUT_S  — whole-campaign persist-context timeout.
ORION_VALIDATION_MAX_STEPS=1000000
ORION_VALIDATION_MAX_WALL_S=5
ORION_VALIDATION_TIMEOUT_S=60

# Lumencast convergence migration flag (ADR 007 §C.5).
#   bespoke (default) — no LSML persisted/served; local startup is a no-op.
#   dual              — LSML bundle ALSO persisted on push + served at
#                       /scenes/{id}/lsml-bundle?v=, beside the bespoke
#                       render-bundle (parallel-run).
#   lsdp              — end state (wire cutover lands in C3/C5).
ORION_LSDP_MODE=bespoke   # bespoke | dual | lsdp

# Execution profile (ADR 016 §3.3). Orion is local-only: the profile below
# wires the SQLite store, local auth, and loopback listeners. The former
# network profile value is retired and rejected at boot.
ORION_PROFILE=embedded-local

# Embedded-local edge inputs. ORION_DATABASE_URL must stay empty; a legacy
# PostgreSQL DSN is rejected in embedded-local. The three base-URLs above
# (ORION_CANVAS_BASE_URL,
# ORION_BLUE_BASE_URL, ORION_ZABGATE_URL) point at Prism's loopback gateway
# sidecar and are required for the nominal HTTP fetch path.
#   ORION_SQLITE_PATH            — single-file local store (under Prism userData). REQUIRED.
#   ORION_VALIDATION_MIRROR_ROOT — REQUIRED since #247. Root dir of the validation
#                                  mirror Prism seeds from the ZabCanvas export; the
#                                  air-eligibility gate imports the `validated` record
#                                  from <root>/canvas/validated/<scene_id>/<hash>.json
#                                  instead of a DB row. Boot fails if unset.
#   ORION_SCENE_BUNDLE_PATH      — OPTIONAL since #246. Set it to serve a FROZEN scene
#                                  bundle offline (the bundledFetcher path, no gateway);
#                                  leave it UNSET for the nominal scene-agnostic HTTP path.
ORION_SQLITE_PATH=/var/lib/orion/orion.db
ORION_VALIDATION_MIRROR_ROOT=/var/lib/orion/validation-mirror
# ORION_SCENE_BUNDLE_PATH=/var/lib/orion/scene-bundle.json  # optional offline fallback (#246)

# Prism<->Orion handshake secret (ADR 016 §3.2-2, #223). REQUIRED when
# ORION_PROFILE=embedded-local. In the embedded-local
# sidecar there is no ZabGate/ZabAuth in front of Orion, so the local
# AuthSource grants the operator role to loopback requests — but ONLY those
# carrying this secret in the `X-Orion-Local-Auth` header. Prism generates a
# high-entropy value at sidecar spawn and passes it here; another local
# process that finds the loopback port cannot impersonate Prism without it.
# Boot FAILS if this is empty in embedded-local (never grant operator
# unguarded). Loopback-only listen + this secret are the two guards (D4/R2).
ORION_LOCAL_OPERATOR_SECRET=
# Separate capability for the editable Preview sideband (Prism generates it
# per process; never reuse the viewer token).
ORION_LOCAL_EDITOR_TOKEN=
# Cosmetic user id stamped on the local operator Identity. Optional; the
# role (operator) is what gates, not the user id.
ORION_LOCAL_AUTH_USER=local-operator
