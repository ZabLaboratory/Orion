## Orion — example environment.
## Copy to ../.env.orion (etage 1) and fill with real values. NEVER commit.

# Debug flag — set to false in production. Fail-closed auth expects false.
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://orion:orion_dev@orion-postgres:5432/orion
ORION_PG_USER=orion
ORION_PG_PASSWORD=orion_dev
ORION_PG_DB=orion

# AES-GCM 256-bit key for at-rest encryption of stream keys + OAuth tokens.
# Generate a fresh one:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# MediaMTX wiring (control plane internal; WHIP base exposed to browsers)
MEDIAMTX_API_URL=http://orion-mediamtx:9997
MEDIAMTX_WHIP_BASE=http://orion-mediamtx:8889
MEDIAMTX_PUBLIC_WHIP_BASE=http://localhost:8889

# Twitch RTMP ingest (no trailing slash; stream key appended by ffmpeg)
TWITCH_RTMP_BASE=rtmp://live.twitch.tv/app

# Twitch OAuth application (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_REDIRECT_URI=http://localhost:3000/settings/twitch/callback

# Public base URL used when handing WHIP URLs back to the browser.
PUBLIC_BASE_URL=http://localhost:4007
