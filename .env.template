# Orion v2 — environment template
# Copy to ../.env.orion (etage 1, never committed) and fill in.

# --- HTTP / WS ---
ORION_LISTEN_ADDR=0.0.0.0:4007
ORION_INTERNAL_ADDR=0.0.0.0:4017      # /internal/metrics, scraped from inside zab_network
ORION_PUBLIC_BASE_URL=https://zabgate.cyell.dev/orion

# --- Postgres ---
ORION_DATABASE_URL=postgres://orion:CHANGEME@orion-postgres:5432/orion?sslmode=disable

# --- Asset filesystem root (content-addressed) ---
ORION_ASSET_ROOT=/var/lib/orion/assets

# --- Static Solar bundle root (per-version directories) ---
ORION_SOLAR_ROOT=/var/lib/orion/solar

# --- Auth ---
# ZabAuth /validate endpoint, called via ZabGate.
# Cache TTL bounds how long Orion trusts a "valid" answer for a given jti.
ORION_ZABAUTH_VALIDATE_URL=http://zabgate:4000/auth/api/v1/tokens
ORION_AUTH_CACHE_TTL_S=60

# Service token Orion presents on outbound calls through ZabGate
# (validator, compile-time fetcher, stream-key proxy). Two modes:
#
#   - Static : leave ORION_OPERATOR_TOKEN empty and paste a long-lived
#     service token here. No mint, no refresh — same posture as
#     pre-Quasar wiring.
#   - Live : set ORION_OPERATOR_TOKEN to an admin JWT. Orion mints a
#     service token at boot via ZabAuth and rotates it 5 min before
#     expiry. ORION_SERVICE_TOKEN below is then used as a fallback if
#     the live mint fails.
ORION_SERVICE_TOKEN=

# Admin JWT used once at boot to mint the service token. Empty → static
# mode. Issue via ZabAuth /auth/login (admin role).
ORION_OPERATOR_TOKEN=

# Paths claim attached to the minted service token. Comma-separated.
# Default narrows to the only outbound surface Orion exercises today
# (the stream-key proxy into Quasar). Add prefixes here when Orion
# gains other authenticated outbound calls.
ORION_SERVICE_PATHS=quasar.credentials.read

# --- Upstream services (compile-time fetch) ---
ORION_CANVAS_BASE_URL=http://zabgate:4000/canvas
ORION_BLUE_BASE_URL=http://zabgate:4000/blue
ORION_QUASAR_BASE_URL=http://zabgate:4000/quasar

# --- Runtime behaviour ---
ORION_TICK_HZ=60
ORION_PUSH_TIMEOUT_S=10
ORION_HTTP_POLL_USER_AGENT=orion-poller/1.0
ORION_LOG_LEVEL=info
ORION_LOG_FORMAT=json   # json | text

# --- Phase-3 async effects (ADR 003 §3.1.3, issue #85) ---
# Parsed at boot; runtime activation is gated behind the phase-4
# validation gate (#87) — exec stays dormant on air until then (R9).

# `http.request` egress policy (R2/B1 — fail-closed). CSV of hostnames
# the blueprint-authored http.request may reach. EMPTY = DENY-ALL.
# https-only unless ORION_HTTP_EGRESS_ALLOW_HTTP=true. Private /
# loopback / link-local / metadata destinations are always denied on
# the IP resolved after DNS (anti-SSRF, no rebinding).
ORION_HTTP_EGRESS_ALLOW_HOSTS=
ORION_HTTP_EGRESS_ALLOW_HTTP=false

# `db.query` DataSource allowlist (topology A — Amendment 1). CSV of
# <logical_name>=<zabgate_svc>; Orion calls
# POST ${ORION_ZABGATE_URL}/<svc>/api/v1/_query with its service token
# (scope query.read.<svc> — add it to ORION_SERVICE_PATHS when minting).
# Orion holds no DB credential and emits no SQL. An undeclared
# DataSource fails compile with DATASOURCE_NOT_DECLARED.
ORION_DATASOURCES=
ORION_ZABGATE_URL=http://zabgate:4000

# Async-effect worker pool bounds.
ORION_EFFECT_WORKERS=8
ORION_EFFECT_QUEUE=256

# Scene-validation gate (ADR 003 §3.2, issue #87). The budget bounds one
# entrypoint's PROOF, never the engine: a divergent logic crosses it, fails
# validation, and never reaches air — the language loses nothing.
#   ORION_VALIDATION_MAX_STEPS  — per-entrypoint step budget (0 = unbounded).
#   ORION_VALIDATION_MAX_WALL_S — per-entrypoint wall budget (0 = unbounded).
#   ORION_VALIDATION_TIMEOUT_S  — whole-campaign persist-context timeout.
ORION_VALIDATION_MAX_STEPS=1000000
ORION_VALIDATION_MAX_WALL_S=5
ORION_VALIDATION_TIMEOUT_S=60

# Lumencast convergence migration flag (ADR 007 §C.5).
#   bespoke (default) — no LSML persisted/served; deploy is a no-op.
#   dual              — LSML bundle ALSO persisted on push + served at
#                       /scenes/{id}/lsml-bundle?v=, beside the bespoke
#                       render-bundle (parallel-run).
#   lsdp              — end state (wire cutover lands in C3/C5).
ORION_LSDP_MODE=bespoke   # bespoke | dual | lsdp
